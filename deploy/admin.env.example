# /opt/samsiani-admin/shared/admin.env on the server (root:root, 600). Secrets; never commit real values.
# SESSION_SECRET: openssl rand -base64 48
SESSION_SECRET=
# EDGE_SECRET: openssl rand -base64 32 — the same value the Cloudflare Transform Rule sends as x-sm-edge
EDGE_SECRET=
ADMIN_USERNAME=
# first boot only (nothing published yet); delete after the first login
ADMIN_INITIAL_PASSWORD=
# SESSION_SECRET_PREV=   old secret during a rotation
# CF_API_TOKEN=          token with Zone.Cache Purge only, if the six fixed-name URLs are cached at the edge
# CF_ZONE_ID=
# Fonts need no key: the catalogue and the font files come from Google's public endpoints, only when the
# owner asks for them, and they are stored under $SITE_HOME/data/fonts/. GOOGLE_FONTS_FIXTURE (and
# GOOGLE_FONTS_FIXTURE_OFFLINE) are read outside production only, for the tests and local development.
