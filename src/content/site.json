      "items": [
        {
          "id": "figma-to-production",
          "title": {
            "en": "Figma to production",
            "ka": "Figma-დან პროდაქშენამდე"
          },
          "text": {
            "en": "I turn a design file into a working Next.js or Vue front end with typed components, accessible markup and a real build pipeline.",
            "ka": "დიზაინის ფაილს ვაქცევ Next.js-ის ან Vue-ს სრულფასოვან ფრონტენდად, ტიპიზებული კომპონენტებით, ხელმისაწვდომი მარკაპითა და რეალური build-პროცესით."
          }
        },
        {
          "id": "custom-wordpress-builds",
          "title": {
            "en": "Custom WordPress builds",
            "ka": "WordPress-ის ინდივიდუალური აწყობა"
          },
          "text": {
            "en": "I model the content the way the business works, using custom post types, ACF fields and editor-friendly blocks, and write a theme that stays fast as the site grows.",
            "ka": "კონტენტს ვაპროექტებ ბიზნესის ლოგიკის შესაბამისად, custom post type-ების, ACF-ველებისა და რედაქტორისთვის მოსახერხებელი ბლოკების გამოყენებით. ვწერ თემას, რომელიც საიტის ზრდასთან ერთად სისწრაფეს ინარჩუნებს."
          }
        },
        {
          "id": "headless-wordpress",
          "title": {
            "en": "Headless WordPress",
            "ka": "Headless WordPress"
          },
          "text": {
            "en": "WordPress stays the editing tool and the data source through REST, WPGraphQL and the Store API, while visitors get a fast Next.js front end.",
            "ka": "WordPress რჩება რედაქტირების ინსტრუმენტად და მონაცემთა წყაროდ REST-ის, WPGraphQL-ისა და Store API-ის გავლით, მომხმარებელი კი იღებს Next.js-ის სწრაფ ფრონტენდს."
          }
        },
        {
          "id": "undocumented-apis",
          "title": {
            "en": "Undocumented APIs",
            "ka": "დაუდოკუმენტებელი API-ები"
          },
          "text": {
            "en": "When a bank, ERP or delivery API has partial or outdated documentation, I map its real behaviour by testing endpoints, logging every request and response, and reconciling state by polling.",
            "ka": "როდესაც ბანკის, ERP-ის ან მიტანის სერვისის API-ს არასრული ან მოძველებული დოკუმენტაცია აქვს, ვადგენ მის რეალურ ქცევას ენდპოინტების ტესტირებით, თითოეული მოთხოვნისა და პასუხის ლოგირებითა და მონაცემთა polling-ით შეჯერებით."
          }
        },
        {
          "id": "plugins-other-developers-use",
          "title": {
            "en": "Plugins other developers use",
            "ka": "პლაგინები სხვა დეველოპერებისთვის"
          },
          "text": {
            "en": "I release WordPress and WooCommerce plugins with licensing, automatic updates, database migrations, safe activation and a clean uninstall.",
            "ka": "ვუშვებ WordPress-ისა და WooCommerce-ის პლაგინებს ლიცენზირებით, ავტომატური განახლებებით, მონაცემთა ბაზის მიგრაციით, უსაფრთხო აქტივაციითა და სუფთა დეინსტალაციით."
          }
        },
